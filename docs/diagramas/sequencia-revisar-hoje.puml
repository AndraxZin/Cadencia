@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
autonumber
actor Estudante
participant ":MenuConsole" as V
participant ":FlashcardService" as S
participant ":FlashcardDaoJdbc" as FD
participant ":RevisaoDaoJdbc" as RD
database "PostgreSQL" as DB

Estudante -> V : opção 1 (Revisar hoje)
V -> S : listarParaRevisarHoje()
S -> FD : listarParaRevisar(hoje)
FD -> DB : SELECT ... WHERE proxima_revisao <= ?
DB --> FD : linhas
FD --> S : lista de Flashcard
S --> V : cartões vencidos
loop para cada cartão
  V -> Estudante : nova tela: Flashcard N de T e a pergunta
  Estudante -> V : Enter
  V -> Estudante : mostra a resposta e pergunta S/N
  Estudante -> V : S ou N
  V -> S : registrarResposta(flashcard, acertou)
  S -> S : proximaEtapa() e intervaloEmDias()
  S -> FD : atualizarAgenda(flashcard)
  FD -> DB : UPDATE flashcard SET etapa, proxima_revisao
  S -> RD : inserir(codigo, acertou)
  RD -> DB : INSERT INTO revisao
  S --> V : data da próxima revisão
  V -> Estudante : explica o resultado (ex.: Acertou! Sobe da etapa 0 para a 1)\ne a próxima revisão
  Estudante -> V : Enter (próximo flashcard)
end
V -> Estudante : Revisão concluída: X acertos e Y erros,\n% de acerto e a próxima revisão
@enduml
